# Copy to .env and fill in. Without a key the public RPC is used (slow, rate-limited).
HELIUS_API_KEY=
# Or set explicit endpoints instead:
# RPC_URL=https://...
# WS_URL=wss://...

# Optional Telegram alerts (create a bot with @BotFather, get chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
